{
  "name": "recall-context",
  "version": "1.0.0",
  "description": "Initialize a repository's memory for AI coding assistants: one command writes evidence-backed context for Claude Code, Codex, Cursor, Gemini CLI, and ChatGPT.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/sabahattink/Recall#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabahattink/Recall.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/sabahattink/Recall/issues",
  "keywords": [
    "cli",
    "ai",
    "ai-agent",
    "coding-agent",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "gemini",
    "chatgpt",
    "context",
    "repository-context",
    "developer-tools"
  ],
  "bin": {
    "recall": "dist/index.js",
    "recall-context": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node ../../scripts/clean-package.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "ignore": "^6.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@recall-ai/core": "workspace:*",
    "@recall-ai/test-fixtures": "workspace:*",
    "@vercel/ncc": "^0.44.1",
    "execa": "^9.5.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
