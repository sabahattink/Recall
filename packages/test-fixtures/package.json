{
  "name": "@recall-ai/test-fixtures",
  "version": "0.1.0",
  "description": "Representative fixture project builders used by Recall's test suites.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
