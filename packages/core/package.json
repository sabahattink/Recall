{
  "name": "@recall-ai/core",
  "version": "0.1.0",
  "description": "Recall's application use cases: orchestrates git, analyzers, and memory into init/scan/update/status/explain/context/doctor.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@recall-ai/analyzers": "workspace:*",
    "@recall-ai/git": "workspace:*",
    "@recall-ai/memory": "workspace:*",
    "@recall-ai/schemas": "workspace:*"
  },
  "devDependencies": {
    "@recall-ai/test-fixtures": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
