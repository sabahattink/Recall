{
  "name": "@recall-ai/schemas",
  "version": "0.1.0",
  "description": "Versioned Zod and JSON schemas for Recall's manifest and snapshot formats.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
